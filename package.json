{
  "name": "pudding-pet",
  "private": true,
  "version": "0.2.0",
  "description": "离线布丁狗风格桌宠原型，改造自 chiikawa-pets",
  "author": "Local Pudding Pet contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/keyboard-asset.mjs && npm run typecheck && vite build",
    "start": "electron .",
    "package:win": "npm run build && node scripts/package.mjs && node scripts/archive.mjs",
    "test:desktop": "node scripts/desktop-test.mjs",
    "test:keyboard": "node scripts/keyboard-render-test.mjs"
  },
  "dependencies": {
    "@lysyyds/win32-mouse-keyboard-hook": "1.0.17",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.10.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "45.1.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-electron": "0.29.0",
    "vitest": "4.0.18"
  }
}
